{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": "frontend/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
   "rewrites": [
  // {
  //   "source": "/api/**",
  //   "function": "api" 
  // },
  {
    "source": "**",
    "destination": "/index.html"
  }
]
  },
  "emulators": {
  "auth": { "port": 9099 },
  "firestore": { "port": 8080 },
  "functions": { "port": 5000 },
  "hosting": { "port": 5002 },
  "ui": { "enabled": true, "port": 4000 }
}
}