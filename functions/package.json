{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:unit": "jest --runInBand tests/unit",
    "test:tz": "cross-env TZ=UTC jest tests/unit/time && cross-env TZ=Asia/Jerusalem jest tests/unit/time",
    "test:integration": "firebase emulators:exec --only auth,firestore --project demo-dolev-test \"jest --runInBand --config jest.integration.config.js\"",
    "test:coverage": "jest --coverage tests/unit",
    "test": "npm run test:unit && npm run test:integration",
    "test:watch": "jest --watch"
  },
  "jest": {
    "collectCoverageFrom": [
      "services/ai/deidentify.js",
      "services/ai/errors.js",
      "services/ai/index.js",
      "middleware/sanitize.middleware.js",
      "middleware/auth.middleware.js",
      "helpers/time.helper.js",
      "helpers/signature.helper.js",
      "helpers/childId.helper.js"
    ]
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@google/genai": "^2.13.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.1",
    "helmet": "^8.2.0",
    "html-pdf-node": "^1.0.7",
    "nodemailer": "^9.0.3"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "firebase-functions-test": "^0.3.3",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "private": true
}
